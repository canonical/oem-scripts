# shellcheck shell=bash
# Helpers for the autopkgtests that run against debian/tests/lp-mock-server
# instead of the real Launchpad.  Source this, then:
#
#   trap lp_mock_cleanup EXIT INT TERM
#   start_lp_mock production
#   export LAUNCHPAD_API="$LP_MOCK_API" LAUNCHPAD_URL="$LP_MOCK_WEB"

LP_MOCK_TMP=$(mktemp -d)
LP_MOCK_PIDS=()
LP_MOCK_API=""
LP_MOCK_WEB=""

lp_mock_cleanup()
{
    local pid
    for pid in ${LP_MOCK_PIDS[@]+"${LP_MOCK_PIDS[@]}"}; do
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    done
    rm -rf "$LP_MOCK_TMP"
}

# start_lp_mock <production|staging>
# Sets LP_MOCK_API and LP_MOCK_WEB to the roots of a freshly started server.
start_lp_mock()
{
    local flavour="$1"
    local server urlfile logfile i

    server="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lp-mock-server"
    urlfile="$LP_MOCK_TMP/$flavour.url"
    logfile="$LP_MOCK_TMP/$flavour.log"

    python3 "$server" --flavour "$flavour" --url-file "$urlfile" >"$logfile" 2>&1 &
    LP_MOCK_PIDS+=("$!")

    for i in $(seq 1 100); do
        if [ -s "$urlfile" ]; then
            break
        fi
        sleep 0.1
    done

    if [ ! -s "$urlfile" ]; then
        echo "The $flavour mock server failed to start:"
        cat "$logfile" || true
        return 1
    fi

    # Read with awk so that this works whatever the caller has set IFS to.
    LP_MOCK_API=$(awk '{print $1}' "$urlfile")
    LP_MOCK_WEB=$(awk '{print $2}' "$urlfile")
    echo "Started the $flavour Launchpad mock at $LP_MOCK_API"
}
