"""A tiny stand-in for the Launchpad REST API.

It serves just enough of api.launchpad.net for the `lp-api`, `get-private-ppa`
and `lp-dl-attm` autopkgtests to run without touching the network.  Only the
shell tools are covered: they build every request from $LAUNCHPAD_API and
$LAUNCHPAD_URL, so pointing those at this server is all that is needed.

The Python tools use launchpadlib, which fetches Launchpad's ~2.6MB WADL before
it will talk to a service root, so they are deliberately out of scope here.

Usage:
  lp-mock-server --flavour production --url-file /tmp/prod.url

It binds an ephemeral port on localhost, writes its own base URL to --url-file
once it is ready to serve, and runs until killed.
"""

import argparse
import json
import os
import re
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

# Bug #1 is asserted verbatim by debian/tests/lp-api, and its web_link is what
# distinguishes a production service root from a staging one.
WEB_LINK_BASE = {
    "production": "https://bugs.launchpad.net",
    "staging": "https://bugs.staging.launchpad.net",
}

# Fingerprints of the two PPAs debian/tests/get-private-ppa checks.
PRIVATE_PPA_FINGERPRINT = "23CBDB455F3792D18EF17E63A630CA96910990FF"
PUBLIC_PPA_FINGERPRINT = "D8027DCFBDAF61FB44D5FDCE9B5F34077FA4288A"

LIVEFS = "~ubuntu-cdimage/+livefs/ubuntu/noble/ubuntu"
BUILD_ID = "1021588"
MANIFEST = "livecd.ubuntu.manifest"
MANIFEST_BODY = b"adduser\t3.137ubuntu1\napt\t2.7.14build2\nbase-files\t13ubuntu10\n"

PUBLIC_BUG = "1"
ATTACHMENT_BUG_PUBLIC = "1000001"
ATTACHMENT_BUG_PRIVATE = "1000002"
ATTACHMENTS = {
    ATTACHMENT_BUG_PUBLIC: [("public-attachment.txt", b"public attachment\n")],
    ATTACHMENT_BUG_PRIVATE: [("private-attachment.txt", b"private attachment\n")],
}


class MockState:
    """The handful of resources the tests are allowed to mutate."""

    def __init__(self):
        self.lock = threading.Lock()
        self.bug_tags = {"100": []}
        self.bug_messages = {"100": []}


class Handler(BaseHTTPRequestHandler):
    # Set by main().
    api_base = ""
    web_base = ""
    flavour = "production"
    state = None

    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        # Keep the testbed's stderr clean; the caller redirects our stdout.
        sys.stdout.write("%s - %s\n" % (self.address_string(), fmt % args))
        sys.stdout.flush()

    # -- plumbing ---------------------------------------------------------

    def _send(self, code, body=b"", content_type="application/json", headers=None):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _send_json(self, payload, code=200):
        self._send(code, json.dumps(payload).encode() + b"\n")

    def _not_found(self):
        # Mirror the shape Launchpad returns so lp-api's error path behaves.
        self._send(404, b"Object not found\n", content_type="text/plain")

    def _read_body(self):
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length else b""

    def _path_and_query(self):
        parsed = urlparse(self.path)
        # lp-api can emit '//devel/...' when a caller passes ${LAUNCHPAD_API}/...
        path = re.sub("/{2,}", "/", unquote(parsed.path)).rstrip("/")
        # The API root and the web root have to be disjoint prefixes, because
        # lp-api decides between "fetch a resource" and "download a file" by
        # matching the URL against $LAUNCHPAD_API and $LAUNCHPAD_URL.
        for prefix in ("/api", "/web"):
            if path == prefix or path.startswith(prefix + "/"):
                path = path[len(prefix) :]
                break
        return path or "/", parse_qs(parsed.query)

    # -- resources --------------------------------------------------------

    def _person(self, name):
        return {
            "self_link": f"{self.api_base}devel/~{name}",
            "name": name,
            "display_name": "Mock User",
            "preferred_email_address_link": (
                f"{self.api_base}devel/~{name}/+email/{name}@example.com"
            ),
        }

    def _bug(self, bug_id):
        payload = {
            "self_link": f"{self.api_base}devel/bugs/{bug_id}",
            "web_link": f"{WEB_LINK_BASE[self.flavour]}/bugs/{bug_id}",
            "id": int(bug_id),
            "date_created": "2004-08-20T00:00:00+00:00",
            "title": f"Mock bug {bug_id}",
            "information_type": "Public",
            "tags": [],
            "attachments_collection_link": (
                f"{self.api_base}devel/bugs/{bug_id}/attachments"
            ),
        }
        if bug_id in ATTACHMENTS:
            payload["date_created"] = "2021-04-13T00:00:00+00:00"
            if bug_id == ATTACHMENT_BUG_PRIVATE:
                payload["information_type"] = "Private"
        with self.state.lock:
            if bug_id in self.state.bug_tags:
                payload["tags"] = list(self.state.bug_tags[bug_id])
        return payload

    def _attachments(self, bug_id):
        entries = []
        for index, (title, _) in enumerate(ATTACHMENTS[bug_id], start=1):
            entries.append(
                {
                    "self_link": (
                        f"{self.api_base}devel/bugs/{bug_id}/+attachment/{index}"
                    ),
                    "title": title,
                    # lp-dl-attm wgets this directly for public bugs and feeds
                    # it back through lp-api for private ones, so it has to be
                    # reachable under both roots.
                    "data_link": (
                        f"{self.web_base}/+attachment/{index}/+files/{title}"
                    ),
                }
            )
        return {"start": 0, "total_size": len(entries), "entries": entries}

    def _archive(self, owner, name):
        private = owner == "oem-solutions-group"
        return {
            "self_link": f"{self.api_base}devel/~{owner}/+archive/ubuntu/{name}",
            "name": name,
            "private": private,
            "signing_key_fingerprint": (
                PRIVATE_PPA_FINGERPRINT if private else PUBLIC_PPA_FINGERPRINT
            ),
        }

    def _attachment_body(self, index, filename):
        for entries in ATTACHMENTS.values():
            for position, (title, body) in enumerate(entries, start=1):
                if position == index and title == filename:
                    return body
        return None

    # -- routing ----------------------------------------------------------

    def do_GET(self):
        path, query = self._path_and_query()
        operation = (query.get("ws.op") or [None])[0]

        match = re.fullmatch(r"/devel/people/\+me", path)
        if match:
            return self._send_json(self._person("mock-user"))

        match = re.fullmatch(r"/devel/~([^/]+)/\+email/.+", path)
        if match:
            return self._send_json(
                {
                    "self_link": f"{self.api_base}devel{path[len('/devel'):]}",
                    "email": f"{match.group(1)}@example.com",
                }
            )

        match = re.fullmatch(r"/devel/~([^/]+)/\+archive/ubuntu/([^/]+)", path)
        if match:
            return self._send_json(self._archive(match.group(1), match.group(2)))

        match = re.fullmatch(rf"/devel/{re.escape(LIVEFS)}", path)
        if match:
            return self._send_json(
                {
                    "self_link": f"{self.api_base}devel/{LIVEFS}",
                    "name": "ubuntu",
                    "completed_builds_collection_link": (
                        f"{self.api_base}devel/{LIVEFS}/completed_builds"
                    ),
                }
            )

        match = re.fullmatch(rf"/devel/{re.escape(LIVEFS)}/completed_builds", path)
        if match:
            return self._send_json(
                {
                    "start": 0,
                    "total_size": 1,
                    "entries": [
                        {
                            "self_link": (
                                f"{self.api_base}devel/{LIVEFS}/+build/{BUILD_ID}"
                            ),
                            "buildstate": "Successfully built",
                        }
                    ],
                }
            )

        match = re.fullmatch(rf"/devel/{re.escape(LIVEFS)}/\+build/{BUILD_ID}", path)
        if match:
            if operation == "getFileUrls":
                return self._send_json(
                    [
                        f"{self.web_base}/{LIVEFS}/+build/{BUILD_ID}"
                        f"/+files/livecd.ubuntu.initrd-generic",
                        f"{self.web_base}/{LIVEFS}/+build/{BUILD_ID}"
                        f"/+files/{MANIFEST}",
                    ]
                )
            return self._send_json(
                {"self_link": f"{self.api_base}devel/{LIVEFS}/+build/{BUILD_ID}"}
            )

        # Build artefacts, reachable under either root (see data_link above).
        match = re.fullmatch(
            rf"(?:/devel)?/{re.escape(LIVEFS)}/\+build/{BUILD_ID}/\+files/(.+)", path
        )
        if match:
            if match.group(1) != MANIFEST:
                return self._not_found()
            return self._send(
                200,
                MANIFEST_BODY,
                content_type="text/plain",
                headers={"Content-Disposition": f'attachment; filename="{MANIFEST}"'},
            )

        match = re.fullmatch(r"(?:/devel)?/\+attachment/([0-9]+)/\+files/(.+)", path)
        if match:
            body = self._attachment_body(int(match.group(1)), match.group(2))
            if body is None:
                return self._not_found()
            return self._send(
                200,
                body,
                content_type="text/plain",
                headers={
                    "Content-Disposition": f'attachment; filename="{match.group(2)}"'
                },
            )

        match = re.fullmatch(r"/devel/bugs/([0-9]+)/attachments", path)
        if match:
            if match.group(1) not in ATTACHMENTS:
                return self._not_found()
            return self._send_json(self._attachments(match.group(1)))

        match = re.fullmatch(r"/devel/bugs/([0-9]+)/messages", path)
        if match:
            with self.state.lock:
                messages = list(self.state.bug_messages.get(match.group(1), []))
            return self._send_json(
                {
                    "start": 0,
                    "total_size": len(messages),
                    "entries": [{"content": content} for content in messages],
                }
            )

        match = re.fullmatch(r"/devel/bugs/([0-9]+)", path)
        if match:
            bug_id = match.group(1)
            # Bug #2 does not exist on Launchpad either; lp-api's test relies
            # on that to check the failure path.
            known = {PUBLIC_BUG, "100"} | set(ATTACHMENTS)
            if bug_id not in known:
                return self._not_found()
            return self._send_json(self._bug(bug_id))

        return self._not_found()

    def do_PATCH(self):
        path, _ = self._path_and_query()
        match = re.fullmatch(r"/devel/bugs/([0-9]+)", path)
        if not match:
            return self._not_found()
        bug_id = match.group(1)
        try:
            payload = json.loads(self._read_body() or b"{}")
        except ValueError:
            return self._send(400, b"Bad Request\n", content_type="text/plain")
        with self.state.lock:
            if "tags" in payload:
                self.state.bug_tags[bug_id] = list(payload["tags"])
        return self._send_json(self._bug(bug_id))

    def do_POST(self):
        path, _ = self._path_and_query()
        fields = parse_qs(self._read_body().decode())
        operation = (fields.get("ws.op") or [None])[0]

        match = re.fullmatch(r"/devel/~([^/]+)", path)
        if match and operation == "getArchiveSubscriptionURL":
            archive = (fields.get("archive") or [""])[0]
            name = archive.rstrip("/").split("/")[-1]
            owner = archive.rstrip("/").split("/")[-4].lstrip("~")
            return self._send_json(
                f"https://mock-user:secret@private-ppa.launchpadcontent.net"
                f"/{owner}/{name}/ubuntu"
            )

        match = re.fullmatch(r"/devel/bugs/([0-9]+)", path)
        if match and operation == "newMessage":
            content = (fields.get("content") or [""])[0]
            with self.state.lock:
                self.state.bug_messages.setdefault(match.group(1), []).append(content)
            return self._send_json({"content": content}, code=201)

        return self._not_found()


def main():
    parser = argparse.ArgumentParser(description="Mock Launchpad REST API server.")
    parser.add_argument(
        "--flavour",
        choices=sorted(WEB_LINK_BASE),
        default="production",
        help="which Launchpad instance to imitate (affects web_link only)",
    )
    parser.add_argument(
        "--url-file",
        required=True,
        help="file to write the server's base URL to once it is listening",
    )
    args = parser.parse_args()

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]

    Handler.api_base = f"http://127.0.0.1:{port}/api/"
    # $LAUNCHPAD_URL is the human-facing root; lp-api rewrites it to the API
    # root, so it has to be a prefix that does not overlap with it.
    Handler.web_base = f"http://127.0.0.1:{port}/web"
    Handler.flavour = args.flavour
    Handler.state = MockState()

    tmp = args.url_file + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(f"{Handler.api_base} {Handler.web_base}\n")
    os.rename(tmp, args.url_file)

    server.serve_forever()


if __name__ == "__main__":
    main()
